# Example Terraform Variables File
# Copy this to terraform.tfvars and customize

# AWS Configuration
aws_region     = "us-east-1"
aws_account_id = "782700525901"

# Project Configuration
project_name = "cloudguardian"
environment  = "lab"
team_size    = 4

# VPC Configuration
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]
availability_zones    = ["us-east-1a", "us-east-1b"]

# EC2 Configuration
ec2_instance_type  = "t2.micro"
ec2_instance_count = 2

# RDS Configuration
rds_instance_class     = "db.t2.micro"
rds_allocated_storage  = 20
rds_engine_version     = "8.0"
rds_database_name      = "cloudguardian"
rds_username           = "admin"
# rds_password will be auto-generated

# S3 Configuration
s3_bucket_count = 3

# IAM Configuration
iam_user_count = 4

# Misconfiguration Flags
enable_misconfigurations    = true
misconfig_s3_public_access  = true
misconfig_rds_public_access = true
misconfig_sg_open_ssh       = true
misconfig_disable_encryption = true

# Additional Tags
additional_tags = {
  CostCenter = "Education"
  Owner      = "CSPM-Team"
}
